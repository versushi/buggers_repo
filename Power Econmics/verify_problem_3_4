"""Verify Question 3.4 using only Python's standard library.

Run: python verify_3_4.py
"""

from math import isclose


BIDS = sorted([
    (12.5, "Red", 100), (14, "Red", 100), (18, "Red", 50),
    (10.5, "Blue", 200), (13, "Blue", 200), (15, "Blue", 100),
    (13.5, "Green", 50), (14.5, "Green", 50), (15.5, "Green", 50),
])
COMPANIES = ("Red", "Blue", "Green")


def dispatch(demand):
    """Accept bids in price order; the last accepted bid sets the price."""
    if not 0 < demand <= sum(quantity for _, _, quantity in BIDS):
        raise ValueError("Demand must be positive and within available capacity")
    production = dict.fromkeys(COMPANIES, 0)
    remaining = demand
    for price, company, quantity in BIDS:
        accepted = min(remaining, quantity)
        production[company] += accepted
        remaining -= accepted
        if remaining <= 1e-9:
            return price, production
    raise RuntimeError("Dispatch did not meet demand")


def elastic_equilibrium(load, sensitivity=4.0):
    """Intersect D = load - sensitivity * price with staircase supply.

    Also handles intersections on horizontal supply plateaus (between
    successive bid prices) in this price-on-x-axis representation.
    """
    lower_quantity = 0
    for i, (price, _, quantity) in enumerate(BIDS):
        upper_quantity = lower_quantity + quantity
        demand = load - sensitivity * price
        if lower_quantity <= demand <= upper_quantity:
            return price, demand
        if i + 1 < len(BIDS):
            plateau_price = (load - upper_quantity) / sensitivity
            next_price = BIDS[i + 1][0]
            if price <= plateau_price <= next_price:
                return plateau_price, upper_quantity
        lower_quantity = upper_quantity
    raise ValueError("No equilibrium within the offered supply range")


def main():
    print("PART A: Supply curve")
    print("Company   Bid (MWh)   Price ($/MWh)   Cumulative (MWh)")
    cumulative = 0
    curve = []
    for price, company, quantity in BIDS:
        cumulative += quantity
        curve.append(cumulative)
        print(f"{company:<9} {quantity:>9} {price:>15.2f} {cumulative:>18}")
    assert curve == [200, 300, 500, 550, 650, 700, 800, 850, 900]

    print("\nPART B: Fixed demand (one-hour period)")
    expected = {
        400: (13, (100, 300, 0), (1300, 3900, 0)),
        600: (14, (150, 400, 50), (2100, 5600, 700)),
        875: (18, (225, 500, 150), (4050, 9000, 2700)),
    }
    for load, (expected_price, expected_output, expected_revenue) in expected.items():
        price, production = dispatch(load)
        output = tuple(production[c] for c in COMPANIES)
        revenue = tuple(price * q for q in output)
        assert isclose(price, expected_price)
        assert output == expected_output
        assert revenue == expected_revenue
        assert isclose(sum(output), load)
        print(f"\nLoad: {load} MW; market price: ${price:.2f}/MWh")
        for company, quantity, income in zip(COMPANIES, output, revenue):
            print(f"  {company:<5}: {quantity:6.1f} MWh; revenue ${income:,.2f}")

    print("\nPART C: Price-sensitive demand, D = L - 4 * price")
    for load, expected_price, expected_quantity in [
        (400, 13, 348), (600, 13.5, 546), (875, 15.5, 813)
    ]:
        price, quantity = elastic_equilibrium(load)
        dispatch_price, production = dispatch(quantity)
        assert isclose(price, expected_price)
        assert isclose(quantity, expected_quantity)
        assert isclose(quantity, load - 4 * price)
        assert isclose(sum(production.values()), quantity)
        assert isclose(dispatch_price, price)
        print(f"Load forecast: {load} MW; price: ${price:.2f}/MWh; "
              f"traded: {quantity:.1f} MWh; reduction: {load - quantity:.1f} MWh")

    print("\nAll Question 3.4 checks passed.")


if __name__ == "__main__":
    main()
